<Window x:Class="FilipBoard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Filip Board FAN Control" Width="1280" Height="820" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Views/Views.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14">
                <StackPanel DockPanel.Dock="Top" Margin="6,6,0,18">
                    <TextBlock FontSize="11" Foreground="{StaticResource Red}" FontWeight="Bold" Text="FILIP BOARD"/>
                    <TextBlock FontSize="19" FontWeight="SemiBold" Text="FAN CONTROL"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="{Binding ProfileText}" Style="{StaticResource Muted}" Margin="6,0,0,8"/>
                    <Button Style="{StaticResource Danger}" Content="FULL SPEED (emergency)" Command="{Binding EmergencyCommand}" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding EmergencyMessage}" Style="{StaticResource Muted}" FontSize="11"/>
                </StackPanel>
                <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" BorderThickness="0" Background="Transparent">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="b" Padding="12,10" CornerRadius="6" Margin="0,2" Background="Transparent" BorderThickness="3,0,0,0" BorderBrush="Transparent">
                                    <ContentPresenter/></Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Surface}"/></Trigger>
                                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Surface2}"/><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Red}"/></Trigger>
                                </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" FontSize="14"/></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Content -->
        <DockPanel Grid.Column="1" Margin="22,18,10,10">
            <Border DockPanel.Dock="Top" CornerRadius="8" Padding="12,8" Margin="0,0,12,12"
                    Visibility="{Binding Banner, Converter={StaticResource NotEmptyVis}}">
                <Border.Style><Style TargetType="Border">
                    <Setter Property="Background" Value="#1A2A33"/>
                    <Style.Triggers><DataTrigger Binding="{Binding BannerIsWarning}" Value="True"><Setter Property="Background" Value="#4A2A10"/></DataTrigger></Style.Triggers>
                </Style></Border.Style>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Restart as Administrator" Command="{Binding RestartAdminCommand}" Margin="12,0,0,0"
                            Visibility="{Binding ShowAdminButton, Converter={StaticResource BoolVis}}"/>
                    <TextBlock Text="{Binding Banner}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
            <ContentControl Content="{Binding SelectedPage}"/>
        </DockPanel>
    </Grid>
</Window>
